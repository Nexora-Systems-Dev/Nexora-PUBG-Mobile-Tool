<Window x:Class="Nexora.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nexora PUBG Mobile Tool"
        Icon="Assets/Icons/nexora.ico"
        Width="1440"
        Height="900"
        MinWidth="1180"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="True"
        Background="Transparent"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        SourceInitialized="Window_SourceInitialized"
        SizeChanged="Window_SizeChanged"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
        <Border Background="{StaticResource PageBackground}" BorderBrush="#263642" BorderThickness="1">
        <Grid x:Name="MainLayoutGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="76" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{StaticResource HeaderBackgroundBrush}" BorderBrush="#1B2936" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid x:Name="TitleBarGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="TitleBrandColumn" Width="260" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="180" />
                    </Grid.ColumnDefinitions>
                    <!-- Cyan Hairline Accent at Top of Shell -->
                    <Border Grid.ColumnSpan="3" Height="1" VerticalAlignment="Top" IsHitTestVisible="False">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#0000D2FF" Offset="0" />
                                <GradientStop Color="#9000D2FF" Offset="0.12" />
                                <GradientStop Color="#3000D2FF" Offset="0.45" />
                                <GradientStop Color="#0500D2FF" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Border Grid.Column="0" Width="360" HorizontalAlignment="Left" Background="{StaticResource HeaderAccentGlowBrush}" Opacity="0.6" IsHitTestVisible="False" />
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="26,0,0,0">
                        <Border Width="38" Height="38" Background="#0A141D" BorderBrush="#00D2FF" BorderThickness="1" CornerRadius="8" Margin="0,0,13,0">
                            <Border.Effect>
                                <DropShadowEffect Color="#00D2FF" BlurRadius="12" ShadowDepth="0" Opacity="0.35" />
                            </Border.Effect>
                            <Image Source="Assets/Icons/nexora.ico" Width="26" Height="26" Stretch="Uniform" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="NEXORA" Foreground="{StaticResource TextPrimary}" FontFamily="Bahnschrift SemiCondensed" FontSize="22" FontWeight="SemiBold" />
                            <TextBlock Text="PUBG MOBILE TOOL" Foreground="#00D2FF" FontFamily="Segoe UI" FontSize="9.5" FontWeight="Bold" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0">
                        <Border x:Name="TopConnectionPill" Background="#0A131C" BorderBrush="#1E3244" BorderThickness="1" CornerRadius="15" Padding="12,5">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="16" Height="16" CornerRadius="8" Background="#060C12" BorderBrush="#142330" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <Ellipse x:Name="TopConnectionDot" Width="6" Height="6" Fill="{StaticResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock x:Name="TopConnectionText" Text="Not connected" Foreground="{StaticResource TextSecondary}" FontFamily="Segoe UI" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border Width="1" Height="22" Background="#1C2D3C" Margin="16,0,16,0" />
                    </StackPanel>
                    <Border Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0" Background="#080E14" BorderBrush="#1B2936" BorderThickness="1" CornerRadius="8" Padding="2">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="MinimizeWindowButton" Click="MinimizeButton_Click" Width="36" Height="28" Margin="0,0,2,0" Style="{StaticResource WindowControlButtonStyle}" ToolTip="Minimize">
                                <Path Data="M 4,14 L 16,14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Button>
                            <Button x:Name="MaximizeWindowButton" Click="MaximizeButton_Click" Width="36" Height="28" Margin="0,0,2,0" Style="{StaticResource WindowControlButtonStyle}" ToolTip="Maximize / Restore">
                                <Path Data="M 4,4 L 16,4 L 16,16 L 4,16 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" StrokeLineJoin="Round" Fill="Transparent" />
                            </Button>
                            <Button x:Name="CloseWindowButton" Click="CloseButton_Click" Width="36" Height="28" Style="{StaticResource CloseWindowButtonStyle}" ToolTip="Close">
                                <Path Data="M 5,5 L 15,15 M 15,5 L 5,15" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource SidebarBackground}" BorderBrush="#1B2936" BorderThickness="0,0,1,0">
                <DockPanel>
                    <!-- GAMELOOP LINK Card with Obsidian Glass styling -->
                    <Border DockPanel.Dock="Bottom" Margin="14,14,14,18" Padding="14" BorderBrush="#1C2F40" BorderThickness="1" CornerRadius="10" Background="{StaticResource ConnectionCardBackgroundBrush}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <!-- Header Row: Title & Badge -->
                            <Grid Grid.Row="0">
                                <TextBlock Text="GAMELOOP LINK" Foreground="#64748B" FontSize="9.5" FontWeight="Bold" />
                                <Border Background="#09141D" BorderBrush="#172938" BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right">
                                    <TextBlock Text="LOCAL TOOL" Foreground="#00D2FF" FontSize="8.5" FontWeight="Bold" />
                                </Border>
                            </Grid>
                            <!-- Status Row: Dynamic Glowing Dot + Status Text -->
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,11,0,0" VerticalAlignment="Center">
                                <Border Width="18" Height="18" CornerRadius="9" Background="#081017" BorderBrush="#162736" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,9,0">
                                    <Ellipse x:Name="SidebarConnectionDot" Width="7" Height="7" Fill="{StaticResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock x:Name="SidebarConnectionText" Text="NOT CONNECTED" Foreground="{StaticResource TextPrimary}" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>
                            <!-- Emulator & ADB Detail Container -->
                            <Border Grid.Row="2" Background="#081119" BorderBrush="#152432" BorderThickness="1" CornerRadius="7" Padding="11,8" Margin="0,11,0,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="22" />
                                        <RowDefinition Height="22" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="GameLoop" Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="0" Text="EMULATOR" Foreground="#64748B" FontSize="9.5" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="1" x:Name="SidebarAdbText" Text="ADB: Offline" Foreground="#64748B" FontSize="11.5" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <!-- Upgraded Refresh Connection Button -->
                            <Button Grid.Row="3" x:Name="RefreshConnectionButton" Content="↻  Refresh Connection" Click="ConnectButton_Click" Style="{StaticResource SidebarRefreshButtonStyle}" FontSize="12" Margin="0,11,0,0" />
                        </Grid>
                    </Border>
                    <StackPanel Margin="0,20,0,0">
                        <TextBlock Text="WORKSPACE" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="SemiBold" Margin="24,0,0,8" />
                        <RadioButton Tag="Graphics" GroupName="Navigation" IsChecked="True" Click="NavigationButton_Click" Style="{StaticResource NavButtonStyle}" Height="54">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="34" Height="22">
                                    <Path Data="M 3,4 L 17,4 L 17,14 L 3,14 Z M 6,17 L 14,17 M 10,14 L 10,17 M 5,11 L 8,8 L 11,10 L 15,6" Width="18" Height="18" Stretch="Fill" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.3" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                </Grid>
                                <TextBlock Text="Graphics" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Tag="Optimizer" GroupName="Navigation" Click="NavigationButton_Click" Style="{StaticResource NavButtonStyle}" Height="54">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="34" Height="22">
                                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="16" TextAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Text="Optimizer" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Tag="Network" GroupName="Navigation" Click="NavigationButton_Click" Style="{StaticResource NavButtonStyle}" Height="54">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="34" Height="22">
                                    <Path Data="M 5,7 L 8,7 C 9.3,7 10,8 10,9 C 10,10 9.3,11 8,11 L 5,11 C 3.7,11 3,10 3,9 C 3,8 3.7,7 5,7 M 12,11 L 15,11 C 16.3,11 17,12 17,13 C 17,14 16.3,15 15,15 L 12,15 C 10.7,15 10,14 10,13 C 10,12 10.7,11 12,11 M 9,10 L 11,12" Width="18" Height="18" Stretch="Fill" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.3" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                </Grid>
                                <TextBlock Text="Network &amp; View" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Tag="Shortcuts" GroupName="Navigation" Click="NavigationButton_Click" Style="{StaticResource NavButtonStyle}" Height="54">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="34" Height="22">
                                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="16" TextAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Text="Shortcuts" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Tag="About" GroupName="Navigation" Click="NavigationButton_Click" Style="{StaticResource NavButtonStyle}" Height="54">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="34" Height="22">
                                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="16" TextAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Text="About" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Row="1" Grid.Column="1" Background="{StaticResource PageBackground}">
                <Grid x:Name="GraphicsView" Margin="34,20,34,18" ClipToBounds="True">
                    <Grid.Resources>
                        <!-- Modern Cyber/Esports Cyan Accent Palette for Graphics Page -->
                        <SolidColorBrush x:Key="Accent" Color="#00D2FF" />
                        <SolidColorBrush x:Key="AccentSoft" Color="#102534" />
                        <SolidColorBrush x:Key="AccentHover" Color="#38BDF8" />
                        <SolidColorBrush x:Key="SegmentTrackBackground" Color="#091219" />
                        <SolidColorBrush x:Key="SegmentTrackBorder" Color="#1B2B38" />

                        <DropShadowEffect x:Key="AccentGlowEffect" Color="#00D2FF" BlurRadius="14" ShadowDepth="0" Opacity="0.55" />
                        <DropShadowEffect x:Key="CardSelectedGlowEffect" Color="#00D2FF" BlurRadius="16" ShadowDepth="0" Opacity="0.6" />
                        <DropShadowEffect x:Key="CtaGlowEffect" Color="#00D2FF" BlurRadius="18" ShadowDepth="2" Opacity="0.45" Direction="270" />

                        <LinearGradientBrush x:Key="GraphicsTopBorderBrush" StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#0000D2FF" Offset="0" />
                            <GradientStop Color="#9000D2FF" Offset="0.5" />
                            <GradientStop Color="#0000D2FF" Offset="1" />
                        </LinearGradientBrush>

                        <RadialGradientBrush x:Key="GraphicsAccentGlowBrush" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                            <GradientStop Color="#4000D2FF" Offset="0" />
                            <GradientStop Color="#0000D2FF" Offset="1" />
                        </RadialGradientBrush>

                        <LinearGradientBrush x:Key="PrimaryCtaBackground" StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#00D2FF" Offset="0" />
                            <GradientStop Color="#0096EB" Offset="1" />
                        </LinearGradientBrush>
                        <LinearGradientBrush x:Key="PrimaryCtaBackgroundHover" StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#38BDF8" Offset="0" />
                            <GradientStop Color="#0EA5E9" Offset="1" />
                        </LinearGradientBrush>
                        <LinearGradientBrush x:Key="PrimaryCtaBackgroundPressed" StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#0284C7" Offset="0" />
                            <GradientStop Color="#0369A1" Offset="1" />
                        </LinearGradientBrush>

                        <!-- Segmented Control Button Style -->
                        <Style x:Key="GraphicsSegmentButtonStyle" TargetType="RadioButton">
                            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="FontFamily" Value="Segoe UI" />
                            <Setter Property="FontSize" Value="13" />
                            <Setter Property="FontWeight" Value="Normal" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="Padding" Value="4,0" />
                            <Setter Property="Margin" Value="1,0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="RadioButton">
                                        <Border x:Name="SegmentBorder"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="6"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="SegmentBorder" Property="Background" Value="#152432" />
                                                <Setter TargetName="SegmentBorder" Property="BorderBrush" Value="#22374A" />
                                                <Setter Property="Foreground" Value="#F2EEE7" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="SegmentBorder" Property="Background" Value="#102534" />
                                                <Setter TargetName="SegmentBorder" Property="BorderBrush" Value="#00D2FF" />
                                                <Setter Property="Foreground" Value="#00D2FF" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                <Setter TargetName="SegmentBorder" Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect Color="#00D2FF" BlurRadius="10" ShadowDepth="0" Opacity="0.4" />
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.38" />
                                                <Setter Property="Cursor" Value="Arrow" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>

                        <!-- Style Preview Card Button Style -->
                        <Style x:Key="GraphicsStyleCardButton" TargetType="ToggleButton">
                            <Setter Property="Background" Value="#0B131B" />
                            <Setter Property="BorderBrush" Value="#1E2E3C" />
                            <Setter Property="BorderThickness" Value="1.5" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="CardBorder"
                                                CornerRadius="8"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                Background="{TemplateBinding Background}"
                                                SnapsToDevicePixels="True">
                                            <Grid>
                                                <!-- Rounded Corner Clipped Container -->
                                                <Border CornerRadius="7" ClipToBounds="True">
                                                    <Border.OpacityMask>
                                                        <VisualBrush Stretch="None" AlignmentX="Left" AlignmentY="Top">
                                                            <VisualBrush.Visual>
                                                                <Border Background="Black" CornerRadius="7"
                                                                        Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Border}}"
                                                                        Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Border}}" />
                                                            </VisualBrush.Visual>
                                                        </VisualBrush>
                                                    </Border.OpacityMask>
                                                    <Grid>
                                                        <ContentPresenter />
                                                        <!-- Bottom vignette gradient for contrast -->
                                                        <Border VerticalAlignment="Bottom" Height="46" IsHitTestVisible="False">
                                                            <Border.Background>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                    <GradientStop Color="#00070D14" Offset="0" />
                                                                    <GradientStop Color="#C0070D14" Offset="1" />
                                                                </LinearGradientBrush>
                                                            </Border.Background>
                                                        </Border>
                                                    </Grid>
                                                </Border>

                                                <!-- Hover Overlay -->
                                                <Border x:Name="HoverOverlay" CornerRadius="7" Background="#1200D2FF" Opacity="0" IsHitTestVisible="False" />

                                                <!-- Selected Badge in Top Right Corner -->
                                                <Border x:Name="SelectedBadge"
                                                        Width="24" Height="24"
                                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                                        Margin="0,8,8,0"
                                                        Background="#00D2FF"
                                                        CornerRadius="12"
                                                        Visibility="Collapsed"
                                                        IsHitTestVisible="False">
                                                    <Border.Effect>
                                                        <DropShadowEffect Color="#00D2FF" BlurRadius="8" ShadowDepth="0" Opacity="0.85" />
                                                    </Border.Effect>
                                                    <Path Data="M 3,6.5 L 6,9.5 L 11,3.5"
                                                          Stroke="#07121A"
                                                          StrokeThickness="2"
                                                          StrokeStartLineCap="Round"
                                                          StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#38BDF8" />
                                                <Setter TargetName="HoverOverlay" Property="Opacity" Value="1" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#00D2FF" />
                                                <Setter TargetName="CardBorder" Property="BorderThickness" Value="2" />
                                                <Setter TargetName="CardBorder" Property="Effect" Value="{StaticResource CardSelectedGlowEffect}" />
                                                <Setter TargetName="SelectedBadge" Property="Visibility" Value="Visible" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.45" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>

                        <!-- Primary CTA Apply Settings Button Style -->
                        <Style x:Key="GraphicsApplyButtonStyle" TargetType="Button">
                            <Setter Property="Foreground" Value="#061219" />
                            <Setter Property="FontFamily" Value="Segoe UI" />
                            <Setter Property="FontSize" Value="13" />
                            <Setter Property="FontWeight" Value="Bold" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Padding" Value="32,13" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="CtaBorder"
                                                CornerRadius="8"
                                                Background="{StaticResource PrimaryCtaBackground}"
                                                BorderBrush="#5AE1FF"
                                                BorderThickness="1"
                                                Padding="{TemplateBinding Padding}"
                                                Effect="{StaticResource CtaGlowEffect}">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Path Data="M 1,6 L 4.5,9.5 L 11,2"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      StrokeThickness="2"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,10,0" />
                                                <TextBlock Text="APPLY SETTINGS"
                                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                           FontWeight="Bold"
                                                           FontSize="13"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CtaBorder" Property="Background" Value="{StaticResource PrimaryCtaBackgroundHover}" />
                                                <Setter TargetName="CtaBorder" Property="BorderBrush" Value="#90EBFF" />
                                                <Setter TargetName="CtaBorder" Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect Color="#00D2FF" BlurRadius="24" ShadowDepth="2" Opacity="0.65" Direction="270" />
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="CtaBorder" Property="Background" Value="{StaticResource PrimaryCtaBackgroundPressed}" />
                                                <Setter TargetName="CtaBorder" Property="BorderBrush" Value="#0284C7" />
                                                <Setter Property="Foreground" Value="#FFFFFF" />
                                                <Setter TargetName="CtaBorder" Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect Color="#00D2FF" BlurRadius="12" ShadowDepth="1" Opacity="0.4" Direction="270" />
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="CtaBorder" Property="Background" Value="#111B24" />
                                                <Setter TargetName="CtaBorder" Property="BorderBrush" Value="#1E2B38" />
                                                <Setter Property="Foreground" Value="#4B5E6D" />
                                                <Setter TargetName="CtaBorder" Property="Effect" Value="{x:Null}" />
                                                <Setter Property="Cursor" Value="Arrow" />
                                                <Setter Property="Opacity" Value="0.75" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>

                        <!-- Connect Button Style for Graphics Page -->
                        <Style x:Key="GraphicsConnectButtonStyle" TargetType="Button">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                            <Setter Property="BorderBrush" Value="{StaticResource BrightOutlineBrush}" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="FontFamily" Value="Segoe UI" />
                            <Setter Property="FontSize" Value="11" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Padding" Value="14,7" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#00D2FF" />
                                                <Setter TargetName="ButtonBorder" Property="Background" Value="#152330" />
                                                <Setter Property="Foreground" Value="#00D2FF" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="ButtonBorder" Property="Background" Value="#0F1E2A" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.45" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>

                        <!-- ComboBox Style for Graphics Page -->
                        <Style x:Key="GraphicsComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource InputComboBoxStyle}">
                            <Setter Property="ItemContainerStyle">
                                <Setter.Value>
                                    <Style TargetType="ComboBoxItem">
                                        <Setter Property="Background" Value="#111A23" />
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                                        <Setter Property="Padding" Value="12,9" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="VerticalContentAlignment" Value="Center" />
                                        <Setter Property="Template">
