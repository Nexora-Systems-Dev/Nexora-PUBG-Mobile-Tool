                                                <Setter TargetName="DangerBorder" Property="Background" Value="#221217" />
                                                <Setter Property="Foreground" Value="#FFA0A0" />
                                                <Setter TargetName="DangerBorder" Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect Color="#FF5C5C" BlurRadius="14" ShadowDepth="0" Opacity="0.4" />
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="DangerBorder" Property="Background" Value="#170A0F" />
                                                <Setter TargetName="DangerBorder" Property="BorderBrush" Value="#CC3333" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.45" />
                                                <Setter Property="Cursor" Value="Arrow" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Grid.Resources>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.RowSpan="3" Background="{StaticResource OptimizerPageBackgroundBrush}" BorderBrush="#1B2B37" BorderThickness="1" CornerRadius="18" IsHitTestVisible="False" />
                    <Border Grid.RowSpan="3" Height="1" Background="{StaticResource OptimizerTopBorderBrush}" VerticalAlignment="Top" Margin="32,1,32,0" Opacity="0.85" IsHitTestVisible="False" />
                    <Ellipse Grid.RowSpan="3" Width="500" Height="500" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-170,-175,0,0" Fill="{StaticResource OptimizerAccentGlowBrush}" Opacity="0.35" IsHitTestVisible="False" />
                    <Ellipse Grid.RowSpan="3" Width="480" Height="480" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-175,-175" Fill="{StaticResource OptimizerCoolGlowBrush}" Opacity="0.25" IsHitTestVisible="False" />

                    <Grid Grid.Row="0" Margin="18,6,18,12">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="4" Height="48" Background="{StaticResource Accent}" CornerRadius="2" Margin="0,0,14,0" Effect="{StaticResource AccentGlowEffect}" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="PERFORMANCE PROFILE" Foreground="{StaticResource Accent}" FontSize="9" FontWeight="SemiBold" Margin="0,0,0,3" />
                                <TextBlock Text="PERFORMANCE CENTER" Foreground="{StaticResource TextPrimary}" FontFamily="Bahnschrift SemiCondensed" FontSize="29" FontWeight="SemiBold" />
                                <TextBlock Text="Tune the GameLoop 64-bit environment around your real hardware." Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,3,0,0" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                            <Border Background="#0C1D2A" BorderBrush="#00D2FF" BorderThickness="1" CornerRadius="6" Padding="12,7" Margin="0,0,10,0">
                                <TextBlock x:Name="ArchitectureText" Text="GAMELOOP 64-BIT" Foreground="#00D2FF" FontSize="11" FontWeight="Bold" />
                            </Border>
                            <Button x:Name="RefreshOptimizerButton" Content="↻  REFRESH HARDWARE" Click="RefreshOptimizerButton_Click" Style="{StaticResource OptimizerOutlineButtonStyle}" FontSize="11" Padding="12,8" />
                        </StackPanel>
                    </Grid>

                    <!-- Hardware Metric Dashboard -->
                    <Border Grid.Row="1" Margin="18,0,18,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.3*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="1.15*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="1.0*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="1.0*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="1.15*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="1.15*" />
                            </Grid.ColumnDefinitions>

                            <!-- Profile & GPU Tile -->
                            <Border Grid.Column="0" Background="{StaticResource MetricTileBackground}" BorderBrush="{StaticResource MetricTileBorder}" BorderThickness="1" CornerRadius="8" Padding="14,10">
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <Ellipse Width="6" Height="6" Fill="#00D2FF" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="DETECTED HARDWARE" Foreground="#6C7F93" FontSize="10" FontWeight="Bold" />
                                    </StackPanel>
                                    <TextBlock x:Name="HardwareProfileText" Text="Detecting system profile..." Foreground="{StaticResource TextPrimary}" FontFamily="Bahnschrift SemiCondensed" FontSize="16" FontWeight="Bold" Margin="0,0,0,2" />
                                    <TextBlock x:Name="HardwareGpuText" Text="GPU —" Foreground="#38BDF8" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>

                            <!-- CPU Tile -->
                            <Border Grid.Column="2" Background="{StaticResource MetricTileBackground}" BorderBrush="{StaticResource MetricTileBorder}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="CPU" Foreground="#6C7F93" FontSize="10" FontWeight="Bold" Margin="0,0,0,4" />
                                    <TextBlock x:Name="HardwareCpuText" Text="—" Foreground="{StaticResource TextPrimary}" FontFamily="Bahnschrift SemiCondensed" FontSize="14" FontWeight="Bold" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Memory Tile -->
                            <Border Grid.Column="4" Background="{StaticResource MetricTileBackground}" BorderBrush="{StaticResource MetricTileBorder}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="MEMORY" Foreground="#6C7F93" FontSize="10" FontWeight="Bold" Margin="0,0,0,4" />
                                    <TextBlock x:Name="HardwareMemoryText" Text="—" Foreground="#00D2FF" FontFamily="Bahnschrift SemiCondensed" FontSize="16" FontWeight="Bold" />
                                </StackPanel>
                            </Border>

                            <!-- Display Tile -->
                            <Border Grid.Column="6" Background="{StaticResource MetricTileBackground}" BorderBrush="{StaticResource MetricTileBorder}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="DISPLAY" Foreground="#6C7F93" FontSize="10" FontWeight="Bold" Margin="0,0,0,4" />
                                    <TextBlock x:Name="HardwareDisplayText" Text="—" Foreground="#00D2FF" FontFamily="Bahnschrift SemiCondensed" FontSize="16" FontWeight="Bold" />
                                </StackPanel>
                            </Border>

                            <!-- Power Tile -->
                            <Border Grid.Column="8" Background="{StaticResource MetricTileBackground}" BorderBrush="{StaticResource MetricTileBorder}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="POWER" Foreground="#6C7F93" FontSize="10" FontWeight="Bold" Margin="0,0,0,4" />
                                    <TextBlock x:Name="HardwarePowerText" Text="—" Foreground="#38BDF8" FontFamily="Bahnschrift SemiCondensed" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Virtualization Tile -->
                            <Border Grid.Column="10" Background="{StaticResource MetricTileBackground}" BorderBrush="{StaticResource MetricTileBorder}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="VIRTUALIZATION" Foreground="#6C7F93" FontSize="10" FontWeight="Bold" Margin="0,0,0,4" />
                                    <TextBlock x:Name="HardwareVirtualizationText" Text="—" Foreground="{StaticResource TextPrimary}" FontFamily="Bahnschrift SemiCondensed" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="18,0,20,2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.7*" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <!-- Smart Optimize Hero Card -->
                                <Border Background="#0C1722" BorderBrush="#00D2FF" BorderThickness="1.5" CornerRadius="10" Padding="18,16" Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="200" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <Border Background="#102534" BorderBrush="#00D2FF" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center">
                                                    <TextBlock Text="AUTOMATED TUNING" Foreground="#00D2FF" FontSize="9" FontWeight="Bold" />
                                                </Border>
                                                <TextBlock Text="SMART OPTIMIZE" Foreground="#00D2FF" FontFamily="Bahnschrift SemiCondensed" FontSize="19" FontWeight="Bold" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="Build a tuned GameLoop profile from your CPU, memory, GPU, display, and power state." Foreground="{StaticResource TextPrimary}" FontSize="13.5" TextWrapping="Wrap" Margin="0,4,20,0" LineHeight="19" />
                                            <Border Background="#091219" BorderBrush="#1C2E3E" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,10,20,0" HorizontalAlignment="Left">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="6" Height="6" Fill="#00D2FF" Margin="0,0,7,0" VerticalAlignment="Center" />
                                                    <TextBlock x:Name="SmartPlanText" Text="Recommended plan is ready." Foreground="#38BDF8" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                        <Button x:Name="SmartSettingsButton" Grid.Column="1" AutomationProperties.Name="SMART OPTIMIZE" Click="SmartSettingsButton_Click" Style="{StaticResource OptimizerHeroButtonStyle}" VerticalAlignment="Center" HorizontalAlignment="Right" Padding="18,13">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <TextBlock Text="SMART OPTIMIZE" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- Tools Header & Buttons -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Border Width="3" Height="16" Background="#00D2FF" CornerRadius="1.5" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="MAINTENANCE TOOLS" Foreground="{StaticResource TextPrimary}" FontFamily="Bahnschrift SemiCondensed" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                                </StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="TempCleanerButton" Grid.Column="0" AutomationProperties.Name="CLEAN CACHE" Click="TempCleanerButton_Click" Style="{StaticResource OptimizerToolButtonStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="15" Margin="0,0,9,0" VerticalAlignment="Center" />
                                            <TextBlock Text="CLEAN CACHE" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="GameLoopOptimizerButton" Grid.Column="2" AutomationProperties.Name="WINDOWS &amp; GPU BOOST" Click="GameLoopOptimizerButton_Click" Style="{StaticResource OptimizerToolButtonStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="15" Margin="0,0,9,0" VerticalAlignment="Center" />
                                            <TextBlock Text="WINDOWS &amp; GPU BOOST" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Apply All Recommended Hero Action Button -->
                                <Button x:Name="AllRecommendedButton" Content="↑  APPLY ALL RECOMMENDED" Click="AllRecommendedButton_Click" Style="{StaticResource OptimizerHeroButtonStyle}" HorizontalAlignment="Left" Padding="26,12" Margin="0,2,0,14" />

                                <!-- Performance Session Card -->
                                <Border Background="#0A121A" BorderBrush="#1C2E3E" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,12">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <Border Background="#102534" BorderBrush="#00D2FF" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <TextBlock Text="SESSION" Foreground="#00D2FF" FontSize="9" FontWeight="Bold" />
                                            </Border>
                                            <TextBlock Text="PERFORMANCE SESSION" Foreground="{StaticResource TextPrimary}" FontFamily="Bahnschrift SemiCondensed" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="Use high-performance power mode and tune running GameLoop processes while you play." Foreground="{StaticResource TextSecondary}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,12" />
                                        <StackPanel Orientation="Horizontal">
                                            <Button x:Name="PerformanceSessionButton" Content="START SESSION" Click="PerformanceSessionButton_Click" Style="{StaticResource OptimizerOutlineButtonStyle}" Padding="16,9" Margin="0,0,10,0" />
                                            <Button x:Name="RestoreSessionButton" Content="RESTORE POWER MODE" Click="RestoreSessionButton_Click" Style="{StaticResource OptimizerOutlineButtonStyle}" Padding="16,9" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Force Close Button -->
                                <Button x:Name="ForceCloseButton" AutomationProperties.Name="FORCE CLOSE GAMELOOP" Click="ForceCloseButton_Click" Style="{StaticResource OptimizerDangerButtonStyle}" HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="15" Margin="0,0,9,0" VerticalAlignment="Center" />
                                        <TextBlock Text="FORCE CLOSE GAMELOOP" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <Border Grid.Column="1" Width="1" Background="#1B2B38" HorizontalAlignment="Center" />

                            <StackPanel Grid.Column="2">
                                <!-- Recommended Plan Card -->
                                <Border Background="#0A121A" BorderBrush="#1C2E3E" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,12">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <Border Width="3" Height="14" Background="#00D2FF" CornerRadius="1.5" Margin="0,0,7,0" VerticalAlignment="Center" />
                                            <TextBlock Text="RECOMMENDED PLAN" Foreground="{StaticResource TextPrimary}" FontFamily="Bahnschrift SemiCondensed" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <Border Background="#0C1D2A" BorderBrush="#00D2FF" BorderThickness="1" CornerRadius="5" Padding="10,5" HorizontalAlignment="Left" Margin="0,0,0,12">
                                            <TextBlock x:Name="PlanTierText" Text="—" Foreground="#00D2FF" FontSize="12" FontWeight="Bold" />
                                        </Border>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="32" />
                                                <RowDefinition Height="32" />
                                                <RowDefinition Height="32" />
                                                <RowDefinition Height="32" />
                                                <RowDefinition Height="32" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Text="CPU allocation" Style="{StaticResource SmallLabelStyle}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Row="0" x:Name="PlanCpuText" Text="—" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />

                                            <TextBlock Grid.Row="1" Text="Memory" Style="{StaticResource SmallLabelStyle}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Row="1" x:Name="PlanMemoryText" Text="—" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />

                                            <TextBlock Grid.Row="2" Text="Render scale" Style="{StaticResource SmallLabelStyle}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Row="2" x:Name="PlanRenderText" Text="—" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />

                                            <TextBlock Grid.Row="3" Text="Frame rate mode" Style="{StaticResource SmallLabelStyle}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Row="3" x:Name="PlanFpsText" Text="—" Foreground="#00D2FF" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" />

                                            <TextBlock Grid.Row="4" Text="GPU route" Style="{StaticResource SmallLabelStyle}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Row="4" x:Name="PlanGpuText" Text="—" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="180" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Activity Card -->
                                <Border Background="#0A121A" BorderBrush="#1C2E3E" BorderThickness="1" CornerRadius="8" Padding="16,14">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <Border Width="3" Height="14" Background="#00D2FF" CornerRadius="1.5" Margin="0,0,7,0" VerticalAlignment="Center" />
                                            <TextBlock Text="ACTIVITY" Foreground="{StaticResource TextPrimary}" FontFamily="Bahnschrift SemiCondensed" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="Actions report their result here. Restart GameLoop when a setting requests it." Foreground="{StaticResource TextSecondary}" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,12" LineHeight="17" />
                                        <TextBlock Text="STATUS" Foreground="#6C7F93" FontSize="10" FontWeight="Bold" Margin="0,0,0,4" />
                                        <Border Background="#091219" BorderBrush="#1C2E3E" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                            <TextBlock x:Name="OptimizerStatusText" Text="Ready" Foreground="#38BDF8" FontSize="13" TextWrapping="Wrap" />
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>

                <Grid x:Name="NetworkView" Visibility="Collapsed" Margin="34,14,34,10" ClipToBounds="True">
                    <Grid.Resources>
                        <!-- Modern Cyber/Esports Electric Cyan Palette for Network Page -->
                        <SolidColorBrush x:Key="Accent" Color="#00D2FF" />
                        <SolidColorBrush x:Key="AccentSoft" Color="#102534" />
                        <SolidColorBrush x:Key="AccentHover" Color="#38BDF8" />

                        <DropShadowEffect x:Key="AccentGlowEffect" Color="#00D2FF" BlurRadius="14" ShadowDepth="0" Opacity="0.55" />
                        <DropShadowEffect x:Key="HeroCtaGlowEffect" Color="#00D2FF" BlurRadius="18" ShadowDepth="2" Opacity="0.45" Direction="270" />

                        <LinearGradientBrush x:Key="NetworkTopBorderBrush" StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#0000D2FF" Offset="0" />
                            <GradientStop Color="#9000D2FF" Offset="0.5" />
                            <GradientStop Color="#0000D2FF" Offset="1" />
                        </LinearGradientBrush>

                        <RadialGradientBrush x:Key="NetworkAccentGlowBrush" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                            <GradientStop Color="#4000D2FF" Offset="0" />
                            <GradientStop Color="#0000D2FF" Offset="1" />
                        </RadialGradientBrush>

                        <RadialGradientBrush x:Key="NetworkCoolGlowBrush" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                            <GradientStop Color="#2500D2FF" Offset="0" />
                            <GradientStop Color="#0000D2FF" Offset="1" />
                        </RadialGradientBrush>

                        <LinearGradientBrush x:Key="PrimaryCtaBackground" StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#00D2FF" Offset="0" />
                            <GradientStop Color="#0096EB" Offset="1" />
                        </LinearGradientBrush>
                        <LinearGradientBrush x:Key="PrimaryCtaBackgroundHover" StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#38BDF8" Offset="0" />
                            <GradientStop Color="#0EA5E9" Offset="1" />
                        </LinearGradientBrush>
                        <LinearGradientBrush x:Key="PrimaryCtaBackgroundPressed" StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#0284C7" Offset="0" />
                            <GradientStop Color="#0369A1" Offset="1" />
                        </LinearGradientBrush>

                        <!-- Hero Primary Action Button Style -->
                        <Style x:Key="NetworkHeroButtonStyle" TargetType="Button">
                            <Setter Property="Background" Value="{StaticResource PrimaryCtaBackground}" />
                            <Setter Property="Foreground" Value="#051019" />
                            <Setter Property="BorderBrush" Value="#40DFFF" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="FontFamily" Value="Bahnschrift SemiCondensed" />
                            <Setter Property="FontSize" Value="14" />
                            <Setter Property="FontWeight" Value="Bold" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Padding" Value="24,12" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="CtaBorder"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="8"
                                                Padding="{TemplateBinding Padding}"
                                                Effect="{StaticResource HeroCtaGlowEffect}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CtaBorder" Property="Background" Value="{StaticResource PrimaryCtaBackgroundHover}" />
                                                <Setter TargetName="CtaBorder" Property="BorderBrush" Value="#90EBFF" />
                                                <Setter TargetName="CtaBorder" Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect Color="#00D2FF" BlurRadius="24" ShadowDepth="2" Opacity="0.65" Direction="270" />
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="CtaBorder" Property="Background" Value="{StaticResource PrimaryCtaBackgroundPressed}" />
                                                <Setter TargetName="CtaBorder" Property="BorderBrush" Value="#0284C7" />
                                                <Setter Property="Foreground" Value="#FFFFFF" />
                                                <Setter TargetName="CtaBorder" Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect Color="#00D2FF" BlurRadius="12" ShadowDepth="1" Opacity="0.4" Direction="270" />
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="CtaBorder" Property="Background" Value="#111B24" />
                                                <Setter TargetName="CtaBorder" Property="BorderBrush" Value="#1E2B38" />
                                                <Setter Property="Foreground" Value="#4B5E6D" />
                                                <Setter TargetName="CtaBorder" Property="Effect" Value="{x:Null}" />
                                                <Setter Property="Cursor" Value="Arrow" />
                                                <Setter Property="Opacity" Value="0.75" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>

                        <!-- Outline Button Style for Network View -->
                        <Style x:Key="NetworkOutlineButtonStyle" TargetType="Button">
                            <Setter Property="Background" Value="#0D1620" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                            <Setter Property="BorderBrush" Value="#223546" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="FontFamily" Value="Segoe UI" />
                            <Setter Property="FontSize" Value="12" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Padding" Value="18,10" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="ButtonBorder"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="6"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#00D2FF" />
                                                <Setter TargetName="ButtonBorder" Property="Background" Value="#152737" />
                                                <Setter Property="Foreground" Value="#00D2FF" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="ButtonBorder" Property="Background" Value="#0E1B26" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.45" />
                                                <Setter Property="Cursor" Value="Arrow" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>

                        <!-- ComboBox Style for Network View -->
                        <Style x:Key="NetworkComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource InputComboBoxStyle}">
                            <Setter Property="Background" Value="#0B131B" />
                            <Setter Property="BorderBrush" Value="#1C2E3E" />
                            <Setter Property="Height" Value="42" />
                            <Setter Property="ItemContainerStyle">
                                <Setter.Value>
                                    <Style TargetType="ComboBoxItem">
                                        <Setter Property="Background" Value="#0B131B" />
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                                        <Setter Property="Padding" Value="12,9" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="VerticalContentAlignment" Value="Center" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ComboBoxItem">
                                                    <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter
                                                            Content="{TemplateBinding Content}"
                                                            ContentTemplate="{TemplateBinding ContentTemplate}"
                                                            ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsHighlighted" Value="True">
                                                            <Setter TargetName="ItemBorder" Property="Background" Value="#102534" />
                                                            <Setter Property="Foreground" Value="#00D2FF" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Grid.Resources>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.RowSpan="2" Background="{StaticResource OptimizerPageBackgroundBrush}" BorderBrush="#1B2B37" BorderThickness="1" CornerRadius="18" IsHitTestVisible="False" />
                    <Border Grid.RowSpan="2" Height="1" Background="{StaticResource NetworkTopBorderBrush}" VerticalAlignment="Top" Margin="32,1,32,0" Opacity="0.85" IsHitTestVisible="False" />
                    <Ellipse Grid.RowSpan="2" Width="500" Height="500" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-170,-175,0,0" Fill="{StaticResource NetworkAccentGlowBrush}" Opacity="0.35" IsHitTestVisible="False" />
                    <Ellipse Grid.RowSpan="2" Width="480" Height="480" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-175,-175" Fill="{StaticResource NetworkCoolGlowBrush}" Opacity="0.25" IsHitTestVisible="False" />

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="18,12,18,16">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="4" Height="48" Background="{StaticResource Accent}" CornerRadius="2" Margin="0,0,14,0" Effect="{StaticResource AccentGlowEffect}" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="NETWORK &amp; DISPLAY TUNING" Foreground="{StaticResource Accent}" FontSize="9" FontWeight="SemiBold" Margin="0,0,0,3" />
                                <TextBlock Text="NETWORK &amp; VIEW" Foreground="{StaticResource TextPrimary}" FontFamily="Bahnschrift SemiCondensed" FontSize="29" FontWeight="SemiBold" />
                                <TextBlock Text="Tune your connection with esports DNS and calibrate iPad aspect ratio canvas." Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,3,0,0" />
                            </StackPanel>
                        </StackPanel>
                        <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#0C1D2A" BorderBrush="#00D2FF" BorderThickness="1" CornerRadius="6" Padding="12,7">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="#00D2FF" Margin="0,0,7,0" VerticalAlignment="Center" />
                                <TextBlock Text="LOW LATENCY ROUTING" Foreground="#00D2FF" FontSize="11" FontWeight="Bold" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Main Cards -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="18,0,18,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="1.08*" />
                            </Grid.ColumnDefinitions>

                            <!-- DNS Changer Card -->
                            <Border Grid.Column="0" Background="#0A121A" BorderBrush="#1C2E3E" BorderThickness="1" CornerRadius="10" Padding="20,18" VerticalAlignment="Top">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Header Row -->
                                    <Grid Grid.Row="0" Margin="0,0,0,4">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="3" Height="15" Background="#00D2FF" CornerRadius="1.5" Margin="0,0,7,0" VerticalAlignment="Center" />
                                            <TextBlock Text="DNS CHANGER" Foreground="{StaticResource TextPrimary}" FontFamily="Bahnschrift SemiCondensed" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <Border HorizontalAlignment="Right" Background="#102534" BorderBrush="#00D2FF" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                            <TextBlock Text="ADAPTER ROUTING" Foreground="#00D2FF" FontSize="9" FontWeight="Bold" />
                                        </Border>
                                    </Grid>

                                    <TextBlock Grid.Row="1" Text="Select an esports provider, test real-time ping latency, and apply direct routing to active network adapters." Foreground="{StaticResource TextSecondary}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,14" LineHeight="18" />

                                    <TextBlock Grid.Row="2" Text="DNS PROVIDER" Foreground="#6C7F93" FontSize="10" FontWeight="Bold" Margin="0,0,0,6" />
                                    <ComboBox Grid.Row="3" x:Name="DnsComboBox" Style="{StaticResource NetworkComboBoxStyle}" SelectionChanged="DnsComboBox_SelectionChanged">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Foreground="{StaticResource TextPrimary}" FontSize="13.5" FontFamily="Segoe UI" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <!-- Telemetry Status Card -->
                                    <Border Grid.Row="4" Background="#0B141D" BorderBrush="#1C2E3E" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,14,0,14">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <Ellipse Width="6" Height="6" Fill="#00D2FF" Margin="0,0,7,0" VerticalAlignment="Center" />
                                                <TextBlock Text="CONNECTION TELEMETRY" Foreground="#6C7F93" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock x:Name="DnsStatusText" Text="Choose a provider to test response time." Foreground="#38BDF8" FontFamily="Bahnschrift SemiCondensed" FontSize="13.5" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Feature Chips -->
                                    <WrapPanel Grid.Row="5" Margin="0,0,0,16">
                                        <Border Background="#0D1722" BorderBrush="#1B2B38" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,8,4">
                                            <TextBlock Text="⚡ Low Jitter Direct Route" Foreground="#8A9CAE" FontSize="11" />
                                        </Border>
                                        <Border Background="#0D1722" BorderBrush="#1B2B38" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,0,4">
                                            <TextBlock Text="🛡️ Anti-DDoS DNS Protection" Foreground="#8A9CAE" FontSize="11" />
                                        </Border>
                                    </WrapPanel>

                                    <Button Grid.Row="6" x:Name="ChangeDnsButton" Content="CHANGE DNS" Click="ChangeDnsButton_Click" Style="{StaticResource NetworkHeroButtonStyle}" HorizontalAlignment="Right" />
                                </Grid>
                            </Border>

                            <Border Grid.Column="1" Width="1" Background="#1B2B38" HorizontalAlignment="Center" />

                            <!-- iPad View Card -->
                            <Border Grid.Column="2" Background="#0A121A" BorderBrush="#1C2E3E" BorderThickness="1" CornerRadius="10" Padding="20,18" VerticalAlignment="Top">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Header Row -->
                                    <Grid Grid.Row="0" Margin="0,0,0,4">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="3" Height="15" Background="#00D2FF" CornerRadius="1.5" Margin="0,0,7,0" VerticalAlignment="Center" />
                                            <TextBlock Text="IPAD VIEW" Foreground="{StaticResource TextPrimary}" FontFamily="Bahnschrift SemiCondensed" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <Border HorizontalAlignment="Right" Background="#102534" BorderBrush="#00D2FF" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                            <TextBlock Text="4:3 ASPECT RATIO" Foreground="#00D2FF" FontSize="9" FontWeight="Bold" />
                                        </Border>
                                    </Grid>

                                    <TextBlock Grid.Row="1" Text="Apply a tested iPad-style aspect ratio and matching GameLoop key layout. Close GameLoop first, then restart it after applying." Foreground="{StaticResource TextSecondary}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,14" LineHeight="18" />

                                    <TextBlock Grid.Row="2" Text="DISPLAY PRESET" Foreground="#6C7F93" FontSize="10" FontWeight="Bold" Margin="0,0,0,6" />
                                    <ComboBox Grid.Row="3" x:Name="IpadComboBox" Style="{StaticResource NetworkComboBoxStyle}" SelectionChanged="IpadComboBox_SelectionChanged" ToolTip="Select an iPad display profile">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Foreground="{StaticResource TextPrimary}" FontSize="13.5" FontFamily="Segoe UI" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <!-- Resolution Preview Card -->
                                    <Border Grid.Row="4" Background="#0B141D" BorderBrush="#1C2E3E" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,14,0,14">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <Ellipse Width="6" Height="6" Fill="#00D2FF" Margin="0,0,7,0" VerticalAlignment="Center" />
                                                <TextBlock Text="PRESET PROFILE DETAILS" Foreground="#6C7F93" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock x:Name="IpadPresetDetailsText" Text="Choose a tested iPad display profile." Foreground="{StaticResource TextPrimary}" FontFamily="Bahnschrift SemiCondensed" FontSize="14" FontWeight="Bold" TextWrapping="Wrap" Margin="0,2,0,2" />
                                            <TextBlock x:Name="IpadApplyStatusText" Text="No profile selected." Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Feature Chips -->
                                    <WrapPanel Grid.Row="5" Margin="0,0,0,16">
                                        <Border Background="#0D1722" BorderBrush="#1B2B38" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,8,4">
                                            <TextBlock Text="📐 Expanded Camera FOV" Foreground="#8A9CAE" FontSize="11" />
                                        </Border>
                                        <Border Background="#0D1722" BorderBrush="#1B2B38" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,0,4">
                                            <TextBlock Text="🎯 Keymap Layout Aligned" Foreground="#8A9CAE" FontSize="11" />
                                        </Border>
                                    </WrapPanel>

                                    <!-- Action Buttons -->
                                    <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button x:Name="ResetIpadButton" Content="RESET" Click="ResetIpadButton_Click" Style="{StaticResource NetworkOutlineButtonStyle}" Margin="0,0,10,0" />
                                        <Button x:Name="ChangeIpadButton" Content="APPLY IPAD VIEW" Click="ChangeIpadButton_Click" Style="{StaticResource NetworkHeroButtonStyle}" IsEnabled="False" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </Grid>

                <Grid x:Name="ShortcutsView" Visibility="Collapsed" Margin="34,14,34,10">
                    <Grid.Resources>
                        <LinearGradientBrush x:Key="ShortcutsTopBorderBrush" StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#0000D2FF" Offset="0.0" />
                            <GradientStop Color="#9000D2FF" Offset="0.5" />
                            <GradientStop Color="#0000D2FF" Offset="1.0" />
                        </LinearGradientBrush>

                        <RadialGradientBrush x:Key="ShortcutsAccentGlowBrush" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                            <GradientStop Color="#4000D2FF" Offset="0" />
                            <GradientStop Color="#0000D2FF" Offset="1" />
                        </RadialGradientBrush>

                        <RadialGradientBrush x:Key="ShortcutsCoolGlowBrush" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                            <GradientStop Color="#2500D2FF" Offset="0" />
                            <GradientStop Color="#0000D2FF" Offset="1" />
                        </RadialGradientBrush>

                        <LinearGradientBrush x:Key="ShortcutsPrimaryCtaBackground" StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#00D2FF" Offset="0" />
                            <GradientStop Color="#0096EB" Offset="1" />
                        </LinearGradientBrush>
                        <LinearGradientBrush x:Key="ShortcutsPrimaryCtaBackgroundHover" StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#38BDF8" Offset="0" />
                            <GradientStop Color="#0EA5E9" Offset="1" />
                        </LinearGradientBrush>
                        <LinearGradientBrush x:Key="ShortcutsPrimaryCtaBackgroundPressed" StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#0284C7" Offset="0" />
                            <GradientStop Color="#0369A1" Offset="1" />
                        </LinearGradientBrush>

                        <DropShadowEffect x:Key="HeroCtaGlowEffect"
                                          Color="#00D2FF"
                                          BlurRadius="18"
                                          ShadowDepth="2"
                                          Opacity="0.45"
                                          Direction="270" />

                        <!-- Hero Primary Action Button Style -->
                        <Style x:Key="ShortcutsHeroButtonStyle" TargetType="Button">
                            <Setter Property="Background" Value="{StaticResource ShortcutsPrimaryCtaBackground}" />
                            <Setter Property="Foreground" Value="#051019" />
                            <Setter Property="BorderBrush" Value="#40DFFF" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="FontFamily" Value="Bahnschrift SemiCondensed" />
                            <Setter Property="FontSize" Value="14" />
                            <Setter Property="FontWeight" Value="Bold" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Padding" Value="24,12" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="CtaBorder"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="8"
                                                Padding="{TemplateBinding Padding}"
                                                Effect="{StaticResource HeroCtaGlowEffect}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CtaBorder" Property="Background" Value="{StaticResource ShortcutsPrimaryCtaBackgroundHover}" />
                                                <Setter TargetName="CtaBorder" Property="BorderBrush" Value="#90EBFF" />
                                                <Setter TargetName="CtaBorder" Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect Color="#00D2FF" BlurRadius="24" ShadowDepth="2" Opacity="0.65" Direction="270" />
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="CtaBorder" Property="Background" Value="{StaticResource ShortcutsPrimaryCtaBackgroundPressed}" />
                                                <Setter TargetName="CtaBorder" Property="BorderBrush" Value="#0284C7" />
                                                <Setter Property="Foreground" Value="#FFFFFF" />
                                                <Setter TargetName="CtaBorder" Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect Color="#00D2FF" BlurRadius="12" ShadowDepth="1" Opacity="0.4" Direction="270" />
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="CtaBorder" Property="Background" Value="#111B24" />
                                                <Setter TargetName="CtaBorder" Property="BorderBrush" Value="#1E2B38" />
                                                <Setter Property="Foreground" Value="#4B5E6D" />
                                                <Setter TargetName="CtaBorder" Property="Effect" Value="{x:Null}" />
                                                <Setter Property="Cursor" Value="Arrow" />
                                                <Setter Property="Opacity" Value="0.75" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>

                        <!-- ComboBox Style for Shortcuts View with DisplayMemberPath support -->
                        <Style x:Key="ShortcutsComboBoxStyle" TargetType="ComboBox">
                            <Setter Property="Background" Value="#0B131B" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                            <Setter Property="BorderBrush" Value="#1C2E3E" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="Padding" Value="12,8" />
                            <Setter Property="FontFamily" Value="Segoe UI" />
                            <Setter Property="FontSize" Value="14" />
                            <Setter Property="Height" Value="42" />
                            <Setter Property="ItemContainerStyle">
                                <Setter.Value>
                                    <Style TargetType="ComboBoxItem">
                                        <Setter Property="Background" Value="#0B131B" />
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                                        <Setter Property="Padding" Value="12,9" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="VerticalContentAlignment" Value="Center" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ComboBoxItem">
                                                    <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter
                                                            Content="{TemplateBinding Content}"
                                                            ContentTemplate="{TemplateBinding ContentTemplate}"
                                                            ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                                            ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsHighlighted" Value="True">
                                                            <Setter TargetName="ItemBorder" Property="Background" Value="#102534" />
                                                            <Setter Property="Foreground" Value="#00D2FF" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ComboBox">
                                        <Grid>
                                            <Border x:Name="ComboBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                                <Grid>
                                                    <ContentPresenter
                                                        Margin="{TemplateBinding Padding}"
                                                        VerticalAlignment="Center"
                                                        IsHitTestVisible="False"
                                                        Content="{TemplateBinding SelectionBoxItem}"
                                                        ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                        ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                        ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                                                    <ToggleButton
                                                        x:Name="DropDownToggleButton"
                                                        Panel.ZIndex="1"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Focusable="False"
                                                        IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                        HorizontalContentAlignment="Stretch"
                                                        VerticalContentAlignment="Stretch">
                                                        <ToggleButton.Template>
                                                            <ControlTemplate TargetType="ToggleButton">
                                                                <Border Background="{TemplateBinding Background}">
                                                                    <Grid>
                                                                        <Path Data="M 0 0 L 5 5 L 10 0" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0" />
                                                                    </Grid>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </ToggleButton.Template>
                                                    </ToggleButton>
                                                </Grid>
                                            </Border>
                                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom" PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade">
                                                <Border Background="#0B131B" BorderBrush="#1C2E3E" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                                    <ScrollViewer MaxHeight="260">
                                                        <ItemsPresenter />
                                                    </ScrollViewer>
                                                </Border>
                                            </Popup>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="#00D2FF" />
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="#00D2FF" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Grid.Resources>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.RowSpan="2" Background="{StaticResource OptimizerPageBackgroundBrush}" BorderBrush="#1B2B37" BorderThickness="1" CornerRadius="18" IsHitTestVisible="False" />
                    <Border Grid.RowSpan="2" Height="1" Background="{StaticResource ShortcutsTopBorderBrush}" VerticalAlignment="Top" Margin="32,1,32,0" Opacity="0.85" IsHitTestVisible="False" />
                    <Ellipse Grid.RowSpan="2" Width="500" Height="500" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-170,-175,0,0" Fill="{StaticResource ShortcutsAccentGlowBrush}" Opacity="0.35" IsHitTestVisible="False" />
                    <Ellipse Grid.RowSpan="2" Width="480" Height="480" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-175,-175" Fill="{StaticResource ShortcutsCoolGlowBrush}" Opacity="0.25" IsHitTestVisible="False" />

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="18,12,18,16">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="4" Height="48" Background="{StaticResource Accent}" CornerRadius="2" Margin="0,0,14,0" Effect="{StaticResource AccentGlowEffect}" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="DESKTOP LAUNCHER ENGINE" Foreground="{StaticResource Accent}" FontSize="9" FontWeight="SemiBold" Margin="0,0,0,3" />
                                <TextBlock Text="SHORTCUTS" Foreground="{StaticResource TextPrimary}" FontFamily="Bahnschrift SemiCondensed" FontSize="29" FontWeight="SemiBold" />
                                <TextBlock Text="Create a clean desktop launcher for any installed PUBG Mobile version." Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,3,0,0" />
                            </StackPanel>
                        </StackPanel>
                        <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#0C1D2A" BorderBrush="#00D2FF" BorderThickness="1" CornerRadius="6" Padding="12,7">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="#00D2FF" Margin="0,0,7,0" VerticalAlignment="Center" />
                                <TextBlock Text="DESKTOP LAUNCHER" Foreground="#00D2FF" FontSize="11" FontWeight="Bold" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Main Cards -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="18,0,18,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.12*" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="0.88*" />
                            </Grid.ColumnDefinitions>

                            <!-- Create a Shortcut Card -->
                            <Border Grid.Column="0" Background="#0A121A" BorderBrush="#1C2E3E" BorderThickness="1" CornerRadius="10" Padding="20,18" VerticalAlignment="Top">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Card Header -->
                                    <Grid Grid.Row="0" Margin="0,0,0,4">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="3" Height="15" Background="#00D2FF" CornerRadius="1.5" Margin="0,0,7,0" VerticalAlignment="Center" />
                                            <TextBlock Text="CREATE A SHORTCUT" Foreground="{StaticResource TextPrimary}" FontFamily="Bahnschrift SemiCondensed" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <Border HorizontalAlignment="Right" Background="#102534" BorderBrush="#00D2FF" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                            <TextBlock Text="DIRECT BOOT" Foreground="#00D2FF" FontSize="9" FontWeight="Bold" />
                                        </Border>
                                    </Grid>

                                    <TextBlock Grid.Row="1" Text="Choose the PUBG Mobile version to launch directly through GameLoop AppMarket." Foreground="{StaticResource TextSecondary}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,16" LineHeight="18" />

                                    <!-- Game Version Selection -->
                                    <StackPanel Grid.Row="2">
                                        <TextBlock Text="GAME VERSION" Foreground="#6C7F93" FontSize="10" FontWeight="Bold" Margin="0,0,0,6" />
                                        <ComboBox x:Name="ShortcutComboBox" Style="{StaticResource ShortcutsComboBoxStyle}" SelectionChanged="ShortcutComboBox_SelectionChanged" />
                                    </StackPanel>

                                    <!-- Selected Profile Preview Card -->
                                    <Border Grid.Row="3" Background="#0B141D" BorderBrush="#1C2E3E" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,16,0,16">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Game Icon with glowing border -->
                                            <Border Grid.Column="0" Width="52" Height="52" Background="#081018" BorderBrush="#223B4E" BorderThickness="1" CornerRadius="8" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,14,0">
                                                <Border.Effect>
