                                                <Setter Property="Foreground" Value="#00D2FF" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="ButtonBorder" Property="Background" Value="#0E1B26" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.45" />
                                                <Setter Property="Cursor" Value="Arrow" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>

                        <!-- Danger Button Style for Force Close -->
                        <Style x:Key="OptimizerDangerButtonStyle" TargetType="Button">
                            <Setter Property="Background" Value="#140E12" />
                            <Setter Property="Foreground" Value="#FF6060" />
                            <Setter Property="BorderBrush" Value="#3D1D24" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="FontFamily" Value="Bahnschrift SemiCondensed" />
                            <Setter Property="FontSize" Value="14" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Padding" Value="18,13" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="DangerBorder"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
