<UserControl x:Class="Nexora.Features.Optimizer.Presentation.OptimizerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Margin="34,14,34,10" ClipToBounds="True">
    <UserControl.Resources>
                        <SolidColorBrush x:Key="MetricTileBackground" Color="#0B131B" />

                        <Style x:Key="OptimizerToolButtonStyle" TargetType="Button">
                            <Setter Property="Background" Value="#0B131B" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="FontFamily" Value="Bahnschrift SemiCondensed" />
                            <Setter Property="FontSize" Value="13.5" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Padding" Value="18,13" />
                            <Setter Property="Margin" Value="0,0,0,10" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="ToolBorder"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="8"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ToolBorder" Property="BorderBrush" Value="{StaticResource Accent}" />
                                                <Setter TargetName="ToolBorder" Property="Background" Value="#122332" />
                                                <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                                <Setter TargetName="ToolBorder" Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect Color="#00D2FF" BlurRadius="12" ShadowDepth="0" Opacity="0.35" />
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="ToolBorder" Property="Background" Value="#0E1B26" />
                                                <Setter TargetName="ToolBorder" Property="BorderBrush" Value="#0284C7" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.45" />
                                                <Setter Property="Cursor" Value="Arrow" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>

                        <Style x:Key="OptimizerDangerButtonStyle" TargetType="Button">
                            <Setter Property="Background" Value="#140E12" />
                            <Setter Property="Foreground" Value="#FF6060" />
                            <Setter Property="BorderBrush" Value="#3D1D24" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="FontFamily" Value="Bahnschrift SemiCondensed" />
                            <Setter Property="FontSize" Value="14" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Padding" Value="18,13" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="DangerBorder"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="8"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="DangerBorder" Property="BorderBrush" Value="#FF5C5C" />
                                                <Setter TargetName="DangerBorder" Property="Background" Value="#221217" />
                                                <Setter Property="Foreground" Value="#FFA0A0" />
                                                <Setter TargetName="DangerBorder" Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect Color="#FF5C5C" BlurRadius="14" ShadowDepth="0" Opacity="0.4" />
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="DangerBorder" Property="Background" Value="#170A0F" />
                                                <Setter TargetName="DangerBorder" Property="BorderBrush" Value="#CC3333" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.45" />
                                                <Setter Property="Cursor" Value="Arrow" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
    </UserControl.Resources>
    <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.RowSpan="3" Background="{StaticResource OptimizerPageBackgroundBrush}" BorderBrush="#1B2B37" BorderThickness="1" CornerRadius="18" IsHitTestVisible="False" />
                    <Border Grid.RowSpan="3" Height="1" Background="{StaticResource PageTopBorderBrush}" VerticalAlignment="Top" Margin="32,1,32,0" Opacity="0.85" IsHitTestVisible="False" />
                    <Ellipse Grid.RowSpan="3" Width="500" Height="500" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-170,-175,0,0" Fill="{StaticResource PageAccentGlowBrush}" Opacity="0.35" IsHitTestVisible="False" />
                    <Ellipse Grid.RowSpan="3" Width="480" Height="480" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-175,-175" Fill="{StaticResource OptimizerCoolGlowBrush}" Opacity="0.25" IsHitTestVisible="False" />

                    <Grid Grid.Row="0" Margin="18,6,18,12">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="4" Height="48" Background="{StaticResource Accent}" CornerRadius="2" Margin="0,0,14,0" Effect="{StaticResource AccentGlowEffect}" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="PERFORMANCE PROFILE" Foreground="{StaticResource Accent}" FontSize="9" FontWeight="SemiBold" Margin="0,0,0,3" />
                                <TextBlock Text="PERFORMANCE CENTER" Foreground="{StaticResource TextPrimary}" FontFamily="Bahnschrift SemiCondensed" FontSize="29" FontWeight="SemiBold" />
                                <TextBlock Text="Tune the GameLoop 64-bit environment around your real hardware." Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,3,0,0" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                            <Border Background="#0C1D2A" BorderBrush="{StaticResource Accent}" BorderThickness="1" CornerRadius="6" Padding="12,7" Margin="0,0,10,0">
                                <TextBlock x:Name="ArchitectureText" Text="GAMELOOP 64-BIT" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="Bold" />
                            </Border>
                            <Button x:Name="RefreshOptimizerButton" Content="↻  REFRESH HARDWARE" Click="RefreshOptimizerButton_Click" Style="{StaticResource PageOutlineButtonStyle}" FontSize="11" Padding="12,8" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Margin="18,0,18,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.3*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="1.15*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="1.0*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="1.0*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="1.15*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="1.15*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{StaticResource MetricTileBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="14,10">
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <Ellipse Width="6" Height="6" Fill="{StaticResource Accent}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="DETECTED HARDWARE" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" />
                                    </StackPanel>
                                    <TextBlock x:Name="HardwareProfileText" Text="Detecting system profile..." Foreground="{StaticResource TextPrimary}" FontFamily="Bahnschrift SemiCondensed" FontSize="16" FontWeight="Bold" Margin="0,0,0,2" />
                                    <TextBlock x:Name="HardwareGpuText" Text="GPU —" Foreground="{StaticResource AccentHover}" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="{StaticResource MetricTileBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="CPU" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,4" />
                                    <TextBlock x:Name="HardwareCpuText" Text="—" Foreground="{StaticResource TextPrimary}" FontFamily="Bahnschrift SemiCondensed" FontSize="14" FontWeight="Bold" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="4" Background="{StaticResource MetricTileBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="MEMORY" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,4" />
                                    <TextBlock x:Name="HardwareMemoryText" Text="—" Foreground="{StaticResource Accent}" FontFamily="Bahnschrift SemiCondensed" FontSize="16" FontWeight="Bold" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="6" Background="{StaticResource MetricTileBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="DISPLAY" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,4" />
                                    <TextBlock x:Name="HardwareDisplayText" Text="—" Foreground="{StaticResource Accent}" FontFamily="Bahnschrift SemiCondensed" FontSize="16" FontWeight="Bold" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="8" Background="{StaticResource MetricTileBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="POWER" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,4" />
                                    <TextBlock x:Name="HardwarePowerText" Text="—" Foreground="{StaticResource AccentHover}" FontFamily="Bahnschrift SemiCondensed" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="10" Background="{StaticResource MetricTileBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="VIRTUALIZATION" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,4" />
                                    <TextBlock x:Name="HardwareVirtualizationText" Text="—" Foreground="{StaticResource TextPrimary}" FontFamily="Bahnschrift SemiCondensed" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="18,0,20,2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.7*" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <Border Background="#0C1722" BorderBrush="{StaticResource Accent}" BorderThickness="1.5" CornerRadius="10" Padding="18,16" Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="200" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <Border Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource Accent}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center">
                                                    <TextBlock Text="AUTOMATED TUNING" Foreground="{StaticResource Accent}" FontSize="9" FontWeight="Bold" />
                                                </Border>
                                                <TextBlock Text="SMART OPTIMIZE" Foreground="{StaticResource Accent}" FontFamily="Bahnschrift SemiCondensed" FontSize="19" FontWeight="Bold" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="Build a tuned GameLoop profile from your CPU, memory, GPU, display, and power state." Foreground="{StaticResource TextPrimary}" FontSize="13.5" TextWrapping="Wrap" Margin="0,4,20,0" LineHeight="19" />
                                            <Border Background="#091219" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,10,20,0" HorizontalAlignment="Left">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="6" Height="6" Fill="{StaticResource Accent}" Margin="0,0,7,0" VerticalAlignment="Center" />
                                                    <TextBlock x:Name="SmartPlanText" Text="Recommended plan is ready." Foreground="{StaticResource AccentHover}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                        <Button x:Name="SmartSettingsButton" Grid.Column="1" AutomationProperties.Name="SMART OPTIMIZE" Click="SmartSettingsButton_Click" Style="{StaticResource HeroButtonStyle}" VerticalAlignment="Center" HorizontalAlignment="Right" Padding="18,13">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <TextBlock Text="SMART OPTIMIZE" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Border Width="3" Height="16" Background="{StaticResource Accent}" CornerRadius="1.5" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="MAINTENANCE TOOLS" Foreground="{StaticResource TextPrimary}" FontFamily="Bahnschrift SemiCondensed" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                                </StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="TempCleanerButton" Grid.Column="0" AutomationProperties.Name="CLEAN CACHE" Click="TempCleanerButton_Click" Style="{StaticResource OptimizerToolButtonStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="15" Margin="0,0,9,0" VerticalAlignment="Center" />
                                            <TextBlock Text="CLEAN CACHE" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="GameLoopOptimizerButton" Grid.Column="2" AutomationProperties.Name="WINDOWS &amp; GPU BOOST" Click="GameLoopOptimizerButton_Click" Style="{StaticResource OptimizerToolButtonStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="15" Margin="0,0,9,0" VerticalAlignment="Center" />
                                            <TextBlock Text="WINDOWS &amp; GPU BOOST" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <Button x:Name="AllRecommendedButton" Content="↑  APPLY ALL RECOMMENDED" Click="AllRecommendedButton_Click" Style="{StaticResource HeroButtonStyle}" HorizontalAlignment="Left" Padding="26,12" Margin="0,2,0,14" />

                                <Border Background="{StaticResource CardSurface}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,12">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <Border Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource Accent}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <TextBlock Text="SESSION" Foreground="{StaticResource Accent}" FontSize="9" FontWeight="Bold" />
                                            </Border>
                                            <TextBlock Text="PERFORMANCE SESSION" Foreground="{StaticResource TextPrimary}" FontFamily="Bahnschrift SemiCondensed" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="Use high-performance power mode and tune running GameLoop processes while you play." Foreground="{StaticResource TextSecondary}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,12" />
                                        <StackPanel Orientation="Horizontal">
                                            <Button x:Name="PerformanceSessionButton" Content="START SESSION" Click="PerformanceSessionButton_Click" Style="{StaticResource PageOutlineButtonStyle}" Padding="16,9" Margin="0,0,10,0" />
                                            <Button x:Name="RestoreSessionButton" Content="RESTORE POWER MODE" Click="RestoreSessionButton_Click" Style="{StaticResource PageOutlineButtonStyle}" Padding="16,9" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Button x:Name="ForceCloseButton" AutomationProperties.Name="FORCE CLOSE GAMELOOP" Click="ForceCloseButton_Click" Style="{StaticResource OptimizerDangerButtonStyle}" HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="15" Margin="0,0,9,0" VerticalAlignment="Center" />
                                        <TextBlock Text="FORCE CLOSE GAMELOOP" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <Border Grid.Column="1" Width="1" Background="#1B2B38" HorizontalAlignment="Center" />

                            <StackPanel Grid.Column="2">
                                <Border Background="{StaticResource CardSurface}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,12">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <Border Width="3" Height="14" Background="{StaticResource Accent}" CornerRadius="1.5" Margin="0,0,7,0" VerticalAlignment="Center" />
                                            <TextBlock Text="RECOMMENDED PLAN" Foreground="{StaticResource TextPrimary}" FontFamily="Bahnschrift SemiCondensed" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <Border Background="#0C1D2A" BorderBrush="{StaticResource Accent}" BorderThickness="1" CornerRadius="5" Padding="10,5" HorizontalAlignment="Left" Margin="0,0,0,12">
                                            <TextBlock x:Name="PlanTierText" Text="—" Foreground="{StaticResource Accent}" FontSize="12" FontWeight="Bold" />
                                        </Border>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="32" />
                                                <RowDefinition Height="32" />
                                                <RowDefinition Height="32" />
                                                <RowDefinition Height="32" />
                                                <RowDefinition Height="32" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Text="CPU allocation" Style="{StaticResource SmallLabelStyle}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Row="0" x:Name="PlanCpuText" Text="—" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />

                                            <TextBlock Grid.Row="1" Text="Memory" Style="{StaticResource SmallLabelStyle}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Row="1" x:Name="PlanMemoryText" Text="—" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />

                                            <TextBlock Grid.Row="2" Text="Render scale" Style="{StaticResource SmallLabelStyle}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Row="2" x:Name="PlanRenderText" Text="—" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />

                                            <TextBlock Grid.Row="3" Text="Frame rate mode" Style="{StaticResource SmallLabelStyle}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Row="3" x:Name="PlanFpsText" Text="—" Foreground="{StaticResource Accent}" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" />

                                            <TextBlock Grid.Row="4" Text="GPU route" Style="{StaticResource SmallLabelStyle}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Row="4" x:Name="PlanGpuText" Text="—" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="180" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Background="{StaticResource CardSurface}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="16,14">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <Border Width="3" Height="14" Background="{StaticResource Accent}" CornerRadius="1.5" Margin="0,0,7,0" VerticalAlignment="Center" />
                                            <TextBlock Text="ACTIVITY" Foreground="{StaticResource TextPrimary}" FontFamily="Bahnschrift SemiCondensed" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="Actions report their result here. Restart GameLoop when a setting requests it." Foreground="{StaticResource TextSecondary}" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,12" LineHeight="17" />
                                        <TextBlock Text="STATUS" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,4" />
                                        <Border Background="#091219" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
                                            <TextBlock x:Name="OptimizerStatusText" Text="Ready" Foreground="{StaticResource AccentHover}" FontSize="13" TextWrapping="Wrap" />
                                        </Border>
                                        <TextBlock Text="DETAILS" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,4" />
                                        <Border Background="#091219" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                            <TextBlock x:Name="OptimizerActivityText" Text="No boost run yet. Each step reports Applied, Skipped, or Failed here." Foreground="{StaticResource TextSecondary}" FontSize="12" TextWrapping="Wrap" />
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
    </Grid>
</UserControl>
