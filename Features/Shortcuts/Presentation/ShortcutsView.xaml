<UserControl x:Class="Nexora.Features.Shortcuts.Presentation.ShortcutsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Margin="34,14,34,10" ClipToBounds="True">
    <UserControl.Resources>
        <Style x:Key="ShortcutsComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource InputComboBoxStyle}">
            <Setter Property="Background" Value="#0B131B" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource ComboBoxItemStyle}">
                        <Setter Property="Background" Value="#0B131B" />
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.RowSpan="2" Background="{StaticResource OptimizerPageBackgroundBrush}" BorderBrush="#1B2B37" BorderThickness="1" CornerRadius="18" IsHitTestVisible="False" />
                    <Border Grid.RowSpan="2" Height="1" Background="{StaticResource PageTopBorderBrush}" VerticalAlignment="Top" Margin="32,1,32,0" Opacity="0.85" IsHitTestVisible="False" />
                    <Ellipse Grid.RowSpan="2" Width="500" Height="500" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-170,-175,0,0" Fill="{StaticResource PageAccentGlowBrush}" Opacity="0.35" IsHitTestVisible="False" />
                    <Ellipse Grid.RowSpan="2" Width="480" Height="480" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-175,-175" Fill="{StaticResource PageCoolGlowBrush}" Opacity="0.25" IsHitTestVisible="False" />

                    <Grid Grid.Row="0" Margin="18,12,18,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Border Width="4" Height="48" Background="{StaticResource Accent}" CornerRadius="2" Margin="0,0,14,0" Effect="{StaticResource AccentGlowEffect}" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="DESKTOP LAUNCHER ENGINE" Foreground="{StaticResource Accent}" FontSize="9" FontWeight="SemiBold" Margin="0,0,0,3" />
                                <TextBlock Text="SHORTCUTS" Foreground="{StaticResource TextPrimary}" FontFamily="Bahnschrift SemiCondensed" FontSize="29" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="Create a clean desktop launcher for any installed PUBG Mobile version." Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,3,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                        <Border Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Background="#0C1D2A" BorderBrush="{StaticResource Accent}" BorderThickness="1" CornerRadius="6" Padding="12,7" Margin="12,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="{StaticResource Accent}" Margin="0,0,7,0" VerticalAlignment="Center" />
                                <TextBlock Text="DESKTOP LAUNCHER" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="Bold" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="18,0,18,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.12*" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="0.88*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{StaticResource CardSurface}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="20,18" VerticalAlignment="Top">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="3" Height="15" Background="{StaticResource Accent}" CornerRadius="1.5" Margin="0,0,7,0" VerticalAlignment="Center" />
                                            <TextBlock Text="CREATE A SHORTCUT" Foreground="{StaticResource TextPrimary}" FontFamily="Bahnschrift SemiCondensed" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Border Grid.Column="1" HorizontalAlignment="Right" Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource Accent}" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="8,0,0,0">
                                            <TextBlock Text="DIRECT BOOT" Foreground="{StaticResource Accent}" FontSize="9" FontWeight="Bold" />
                                        </Border>
                                    </Grid>

                                    <TextBlock Grid.Row="1" Text="Choose the PUBG Mobile version to launch directly through GameLoop AppMarket." Foreground="{StaticResource TextSecondary}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,16" LineHeight="18" />

                                    <StackPanel Grid.Row="2">
                                        <TextBlock Text="GAME VERSION" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,6" />
                                        <ComboBox x:Name="ShortcutComboBox" Style="{StaticResource ShortcutsComboBoxStyle}" SelectionChanged="ShortcutComboBox_SelectionChanged" />
                                    </StackPanel>

                                    <Border Grid.Row="3" Background="#0B141D" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,16,0,16">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Width="52" Height="52" Background="#081018" BorderBrush="#223B4E" BorderThickness="1" CornerRadius="8" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,14,0">
                                                <Border.Effect>
                                                    <DropShadowEffect Color="#00D2FF" BlurRadius="8" ShadowDepth="0" Opacity="0.2" />
                                                </Border.Effect>
                                                <Image x:Name="ShortcutIcon" Width="36" Height="36" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                    <Border Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource Accent}" BorderThickness="1" CornerRadius="3" Padding="5,1" Margin="0,0,8,0">
                                                        <TextBlock Text="SELECTED PROFILE" Foreground="{StaticResource Accent}" FontSize="9" FontWeight="Bold" />
                                                    </Border>
                                                    <TextBlock Text="TARGET METADATA" Foreground="{StaticResource TextMuted}" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock x:Name="ShortcutDisplayNameText" Text="Choose a PUBG Mobile version" Foreground="{StaticResource AccentHover}" FontFamily="Bahnschrift SemiCondensed" FontSize="15" FontWeight="Bold" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                <TextBlock x:Name="ShortcutPackageText" Text="No package selected" Foreground="{StaticResource TextSecondary}" FontSize="12" FontFamily="Consolas" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                    <TextBlock Text="📍" FontSize="10" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                    <TextBlock x:Name="ShortcutDestinationText" Text="The shortcut will be placed on your desktop." Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <WrapPanel Grid.Row="4" Margin="0,0,0,16">
                                        <Border Background="#0D1722" BorderBrush="#1B2B38" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,8,4">
                                            <TextBlock Text="⚡ Native AppMarket Launcher" Foreground="{StaticResource TextSecondary}" FontSize="11" />
                                        </Border>
                                        <Border Background="#0D1722" BorderBrush="#1B2B38" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,0,4">
                                            <TextBlock Text="🎯 Zero Emulator Navigation" Foreground="{StaticResource TextSecondary}" FontSize="11" />
                                        </Border>
                                    </WrapPanel>

                                    <Button Grid.Row="5" x:Name="CreateShortcutButton" Content="CREATE DESKTOP SHORTCUT" Click="CreateShortcutButton_Click" Style="{StaticResource HeroButtonStyle}" HorizontalAlignment="Right" IsEnabled="False" />
                                </Grid>
                            </Border>

                            <Border Grid.Column="1" Width="1" Background="#1B2B38" HorizontalAlignment="Center" />

                            <Border Grid.Column="2" Background="{StaticResource CardSurface}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="20,18" VerticalAlignment="Top">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="3" Height="15" Background="{StaticResource Accent}" CornerRadius="1.5" Margin="0,0,7,0" VerticalAlignment="Center" />
                                            <TextBlock Text="HOW IT WORKS" Foreground="{StaticResource TextPrimary}" FontFamily="Bahnschrift SemiCondensed" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Border Grid.Column="1" HorizontalAlignment="Right" Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource Accent}" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="8,0,0,0">
                                            <TextBlock Text="OFFICIAL LAUNCHER" Foreground="{StaticResource Accent}" FontSize="9" FontWeight="Bold" />
                                        </Border>
                                    </Grid>

                                    <TextBlock Grid.Row="1" Text="The shortcut uses GameLoop's own launcher, so the selected version opens with its verified package parameters." Foreground="{StaticResource TextSecondary}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,20" LineHeight="18" />

                                    <StackPanel Grid.Row="2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                                <Border Width="28" Height="28" Background="#0C1D2A" BorderBrush="{StaticResource Accent}" BorderThickness="1.5" CornerRadius="14">
                                                    <Border.Effect>
                                                        <DropShadowEffect Color="#00D2FF" BlurRadius="8" ShadowDepth="0" Opacity="0.35" />
                                                    </Border.Effect>
                                                    <TextBlock Text="1" Foreground="{StaticResource Accent}" FontSize="12.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <Border Width="1.5" Height="28" Background="{StaticResource DividerStroke}" HorizontalAlignment="Center" Margin="0,4,0,4" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Margin="12,2,0,0">
                                                <TextBlock Text="Select a version" Foreground="{StaticResource TextPrimary}" FontSize="13.5" FontWeight="SemiBold" />
                                                <TextBlock Text="Choose one of the detected PUBG Mobile packages installed in GameLoop." Foreground="{StaticResource TextSecondary}" FontSize="12" TextWrapping="Wrap" LineHeight="16" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                                <Border Width="28" Height="28" Background="#0C1D2A" BorderBrush="{StaticResource Accent}" BorderThickness="1.5" CornerRadius="14">
                                                    <Border.Effect>
                                                        <DropShadowEffect Color="#00D2FF" BlurRadius="8" ShadowDepth="0" Opacity="0.35" />
                                                    </Border.Effect>
                                                    <TextBlock Text="2" Foreground="{StaticResource Accent}" FontSize="12.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <Border Width="1.5" Height="28" Background="{StaticResource DividerStroke}" HorizontalAlignment="Center" Margin="0,4,0,4" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Margin="12,2,0,0">
                                                <TextBlock Text="Create the launcher" Foreground="{StaticResource TextPrimary}" FontSize="13.5" FontWeight="SemiBold" />
                                                <TextBlock Text="Nexora places a clean, official shortcut directly on your Windows desktop." Foreground="{StaticResource TextSecondary}" FontSize="12" TextWrapping="Wrap" LineHeight="16" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                                <Border Width="28" Height="28" Background="#0C1D2A" BorderBrush="{StaticResource Accent}" BorderThickness="1.5" CornerRadius="14">
                                                    <Border.Effect>
                                                        <DropShadowEffect Color="#00D2FF" BlurRadius="8" ShadowDepth="0" Opacity="0.35" />
                                                    </Border.Effect>
                                                    <TextBlock Text="3" Foreground="{StaticResource Accent}" FontSize="12.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Margin="12,2,0,0">
                                                <TextBlock Text="Launch when you need it" Foreground="{StaticResource TextPrimary}" FontSize="13.5" FontWeight="SemiBold" />
                                                <TextBlock Text="Open PUBG Mobile directly with one click without navigating through emulator menus." Foreground="{StaticResource TextSecondary}" FontSize="12" TextWrapping="Wrap" LineHeight="16" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>

                                    <Border Grid.Row="3" Background="#0B141D" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,22,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="18" Height="18" Background="#0C251F" BorderBrush="{StaticResource Success}" BorderThickness="1" CornerRadius="9" VerticalAlignment="Center" Margin="0,0,10,0">
                                                <Ellipse Width="6" Height="6" Fill="{StaticResource Success}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="Zero risk: No game settings or emulator files are modified by this action." Foreground="{StaticResource TextSecondary}" FontSize="11.5" TextWrapping="Wrap" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </ScrollViewer>
    </Grid>
</UserControl>
