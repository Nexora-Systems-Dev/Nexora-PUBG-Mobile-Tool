<UserControl x:Class="Nexora.Features.Network.Presentation.NetworkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Margin="34,14,34,10" ClipToBounds="True">
    <UserControl.Resources>
        <Style x:Key="NetworkComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource InputComboBoxStyle}">
            <Setter Property="Background" Value="#0B131B" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource ComboBoxItemStyle}">
                        <Setter Property="Background" Value="#0B131B" />
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.RowSpan="2" Background="{StaticResource OptimizerPageBackgroundBrush}" BorderBrush="#1B2B37" BorderThickness="1" CornerRadius="18" IsHitTestVisible="False" />
        <Border Grid.RowSpan="2" Height="1" Background="{StaticResource PageTopBorderBrush}" VerticalAlignment="Top" Margin="32,1,32,0" Opacity="0.85" IsHitTestVisible="False" />
        <Ellipse Grid.RowSpan="2" Width="500" Height="500" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-170,-175,0,0" Fill="{StaticResource PageAccentGlowBrush}" Opacity="0.35" IsHitTestVisible="False" />
        <Ellipse Grid.RowSpan="2" Width="480" Height="480" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-175,-175" Fill="{StaticResource PageCoolGlowBrush}" Opacity="0.25" IsHitTestVisible="False" />

        <Grid Grid.Row="0" Margin="18,12,18,16">
            <StackPanel Orientation="Horizontal">
                <Border Width="4" Height="48" Background="{StaticResource Accent}" CornerRadius="2" Margin="0,0,14,0" Effect="{StaticResource AccentGlowEffect}" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="NETWORK &amp; DISPLAY TUNING" Foreground="{StaticResource Accent}" FontSize="9" FontWeight="SemiBold" Margin="0,0,0,3" />
                    <TextBlock Text="NETWORK &amp; VIEW" Foreground="{StaticResource TextPrimary}" FontFamily="Bahnschrift SemiCondensed" FontSize="29" FontWeight="SemiBold" />
                    <TextBlock Text="Tune your connection with esports DNS and calibrate iPad aspect ratio canvas." Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,3,0,0" />
                </StackPanel>
            </StackPanel>
            <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#0C1D2A" BorderBrush="{StaticResource Accent}" BorderThickness="1" CornerRadius="6" Padding="12,7">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="6" Height="6" Fill="{StaticResource Accent}" Margin="0,0,7,0" VerticalAlignment="Center" />
                    <TextBlock Text="LOW LATENCY ROUTING" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="Bold" />
                </StackPanel>
            </Border>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="18,0,18,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="1.08*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource CardSurface}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="20,18" VerticalAlignment="Top">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="3" Height="15" Background="{StaticResource Accent}" CornerRadius="1.5" Margin="0,0,7,0" VerticalAlignment="Center" />
                                <TextBlock Text="DNS CHANGER" Foreground="{StaticResource TextPrimary}" FontFamily="Bahnschrift SemiCondensed" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>
                            <Border HorizontalAlignment="Right" Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource Accent}" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                <TextBlock Text="ADAPTER ROUTING" Foreground="{StaticResource Accent}" FontSize="9" FontWeight="Bold" />
                            </Border>
                        </Grid>

                        <TextBlock Grid.Row="1" Text="Select an esports provider, test real-time ping latency, and apply direct routing to active network adapters." Foreground="{StaticResource TextSecondary}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,14" LineHeight="18" />

                        <TextBlock Grid.Row="2" Text="DNS PROVIDER" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,6" />
                        <ComboBox Grid.Row="3" x:Name="DnsComboBox" Style="{StaticResource NetworkComboBoxStyle}" SelectionChanged="DnsComboBox_SelectionChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="{StaticResource TextPrimary}" FontSize="13.5" FontFamily="Segoe UI" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <Border Grid.Row="4" Background="#0B141D" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,14,0,14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <Ellipse Width="6" Height="6" Fill="{StaticResource Accent}" Margin="0,0,7,0" VerticalAlignment="Center" />
                                    <TextBlock Text="CONNECTION TELEMETRY" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock x:Name="DnsStatusText" Text="Choose a provider to test response time." Foreground="{StaticResource AccentHover}" FontFamily="Bahnschrift SemiCondensed" FontSize="13.5" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <WrapPanel Grid.Row="5" Margin="0,0,0,16">
                            <Border Background="#0D1722" BorderBrush="#1B2B38" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,8,4">
                                <TextBlock Text="⚡ Low Jitter Direct Route" Foreground="{StaticResource TextSecondary}" FontSize="11" />
                            </Border>
                            <Border Background="#0D1722" BorderBrush="#1B2B38" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,0,4">
                                <TextBlock Text="🛡️ Anti-DDoS DNS Protection" Foreground="{StaticResource TextSecondary}" FontSize="11" />
                            </Border>
                        </WrapPanel>

                        <Button Grid.Row="6" x:Name="ChangeDnsButton" Content="CHANGE DNS" Click="ChangeDnsButton_Click" Style="{StaticResource HeroButtonStyle}" HorizontalAlignment="Right" />
                    </Grid>
                </Border>

                <Border Grid.Column="1" Width="1" Background="#1B2B38" HorizontalAlignment="Center" />

                <Border Grid.Column="2" Background="{StaticResource CardSurface}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="20,18" VerticalAlignment="Top">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="3" Height="15" Background="{StaticResource Accent}" CornerRadius="1.5" Margin="0,0,7,0" VerticalAlignment="Center" />
                                <TextBlock Text="IPAD VIEW" Foreground="{StaticResource TextPrimary}" FontFamily="Bahnschrift SemiCondensed" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>
                            <Border HorizontalAlignment="Right" Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource Accent}" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                <TextBlock Text="4:3 ASPECT RATIO" Foreground="{StaticResource Accent}" FontSize="9" FontWeight="Bold" />
                            </Border>
                        </Grid>

                        <TextBlock Grid.Row="1" Text="Apply a tested iPad-style aspect ratio and matching GameLoop key layout. Close GameLoop first, then restart it after applying." Foreground="{StaticResource TextSecondary}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,14" LineHeight="18" />

                        <TextBlock Grid.Row="2" Text="DISPLAY PRESET" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" Margin="0,0,0,6" />
                        <ComboBox Grid.Row="3" x:Name="IpadComboBox" Style="{StaticResource NetworkComboBoxStyle}" SelectionChanged="IpadComboBox_SelectionChanged" ToolTip="Select an iPad display profile">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="{StaticResource TextPrimary}" FontSize="13.5" FontFamily="Segoe UI" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <Border Grid.Row="4" Background="#0B141D" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,14,0,14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <Ellipse Width="6" Height="6" Fill="{StaticResource Accent}" Margin="0,0,7,0" VerticalAlignment="Center" />
                                    <TextBlock Text="PRESET PROFILE DETAILS" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock x:Name="IpadPresetDetailsText" Text="Choose a tested iPad display profile." Foreground="{StaticResource TextPrimary}" FontFamily="Bahnschrift SemiCondensed" FontSize="14" FontWeight="Bold" TextWrapping="Wrap" Margin="0,2,0,2" />
                                <TextBlock x:Name="IpadApplyStatusText" Text="No profile selected." Foreground="{StaticResource TextMuted}" FontSize="12" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <WrapPanel Grid.Row="5" Margin="0,0,0,16">
                            <Border Background="#0D1722" BorderBrush="#1B2B38" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,8,4">
                                <TextBlock Text="📐 Expanded Camera FOV" Foreground="{StaticResource TextSecondary}" FontSize="11" />
                            </Border>
                            <Border Background="#0D1722" BorderBrush="#1B2B38" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,0,4">
                                <TextBlock Text="🎯 Keymap Layout Aligned" Foreground="{StaticResource TextSecondary}" FontSize="11" />
                            </Border>
                        </WrapPanel>

                        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="ResetIpadButton" Content="RESET" Click="ResetIpadButton_Click" Style="{StaticResource PageOutlineButtonStyle}" Margin="0,0,10,0" />
                            <Button x:Name="ChangeIpadButton" Content="APPLY IPAD VIEW" Click="ChangeIpadButton_Click" Style="{StaticResource HeroButtonStyle}" IsEnabled="False" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
