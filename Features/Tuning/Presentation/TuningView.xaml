<UserControl x:Class="Nexora.Features.Tuning.Presentation.TuningView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Margin="34,14,34,10" ClipToBounds="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.RowSpan="2" Background="{StaticResource OptimizerPageBackgroundBrush}" BorderBrush="#1B2B37" BorderThickness="1" CornerRadius="18" IsHitTestVisible="False" />
        <Border Grid.RowSpan="2" Height="1" Background="{StaticResource PageTopBorderBrush}" VerticalAlignment="Top" Margin="32,1,32,0" Opacity="0.85" IsHitTestVisible="False" />
        <Ellipse Grid.RowSpan="2" Width="500" Height="500" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-170,-175,0,0" Fill="{StaticResource PageAccentGlowBrush}" Opacity="0.35" IsHitTestVisible="False" />
        <Ellipse Grid.RowSpan="2" Width="480" Height="480" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-175,-175" Fill="{StaticResource OptimizerCoolGlowBrush}" Opacity="0.25" IsHitTestVisible="False" />

        <Grid Grid.Row="0" Margin="18,12,18,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="3" Height="15" Background="{StaticResource Accent}" CornerRadius="1.5" Margin="0,0,7,0" VerticalAlignment="Center" />
                <TextBlock Text="EMULATOR TUNING" Foreground="{StaticResource TextPrimary}" FontFamily="Bahnschrift SemiCondensed" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                <Border Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource Accent}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="MANUAL REGISTRY" Foreground="{StaticResource Accent}" FontSize="9" FontWeight="Bold" />
                </Border>
            </StackPanel>
            <TextBlock Grid.Row="1" Text="Set processor cores, memory, and emulator internals. Values are forced into the GameLoop registry and take effect after an emulator restart." Foreground="{StaticResource TextSecondary}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,10" LineHeight="18" />
            <Border Grid.Row="2" Background="#171106" BorderBrush="#8A6D1B" BorderThickness="1" CornerRadius="8" Padding="14,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource Warning}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock x:Name="TuningNoticeText" Text="GameLoop must be closed before applying settings." Foreground="{StaticResource Warning}" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Loading affordance for QA F-002/F-008: collapsed unless a refresh is
             in flight. Lives in the fixed header row, is hit-test invisible, and
             takes no layout space, so the scrolling content below never reflows. -->
        <ProgressBar x:Name="TuningLoadingBar" Grid.Row="0" Height="2"
                     VerticalAlignment="Bottom" Margin="20,0,20,-1"
                     IsIndeterminate="True" IsHitTestVisible="False"
                     Visibility="Collapsed" BorderThickness="0"
                     Foreground="{StaticResource Accent}" Background="Transparent" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="18,0,20,2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Column="0" Grid.Row="0">
                    <Border Background="{StaticResource CardSurface}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="20,18" Margin="0,0,0,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Width="3" Height="14" Background="{StaticResource Accent}" CornerRadius="1.5" Margin="0,0,7,0" VerticalAlignment="Center" />
                                <TextBlock Text="PERFORMANCE" Foreground="{StaticResource TextPrimary}" FontFamily="Bahnschrift SemiCondensed" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>
                            <Grid Margin="0,8,0,4">
                                <TextBlock Text="Processor (CPU cores)" Style="{StaticResource SmallLabelStyle}" VerticalAlignment="Center" />
                                <TextBlock x:Name="TuningCpuText" Text="4 cores" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <Slider x:Name="TuningCpuSlider" Minimum="1" Maximum="8" TickFrequency="1" IsSnapToTickEnabled="True" Value="4" ValueChanged="TuningCpuSlider_ValueChanged" Margin="0,0,0,12" />
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Memory" Style="{StaticResource SmallLabelStyle}" VerticalAlignment="Center" />
                                <TextBlock x:Name="TuningMemoryText" Text="4096 MB" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <Slider x:Name="TuningMemorySlider" Minimum="1024" Maximum="16384" TickFrequency="512" IsSnapToTickEnabled="True" Value="4096" ValueChanged="TuningMemorySlider_ValueChanged" />
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource CardSurface}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="20,18">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Width="3" Height="14" Background="{StaticResource Accent}" CornerRadius="1.5" Margin="0,0,7,0" VerticalAlignment="Center" />
                                <TextBlock Text="SYSTEM" Foreground="{StaticResource TextPrimary}" FontFamily="Bahnschrift SemiCondensed" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>
                            <CheckBox x:Name="TuningAdbCheck" Content="ADB debugging" Foreground="{StaticResource TextPrimary}" FontSize="13.5" IsChecked="True" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border Grid.Column="1" Grid.Row="0" Width="1" Background="#1B2B38" HorizontalAlignment="Center" />

                <StackPanel Grid.Column="2" Grid.Row="0">
                    <Border Background="{StaticResource CardSurface}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="20,18" Margin="0,0,0,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Width="3" Height="14" Background="{StaticResource Accent}" CornerRadius="1.5" Margin="0,0,7,0" VerticalAlignment="Center" />
                                <TextBlock Text="GRAPHICS" Foreground="{StaticResource TextPrimary}" FontFamily="Bahnschrift SemiCondensed" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="SCREEN DPI" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" Margin="0,10,0,6" />
                            <ComboBox x:Name="TuningDpiComboBox" Style="{StaticResource InputComboBoxStyle}" Margin="0,0,0,6">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Foreground="{StaticResource TextPrimary}" FontSize="13.5" FontFamily="Segoe UI" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <CheckBox x:Name="TuningRenderCacheCheck" Content="Enable rendering cache" Foreground="{StaticResource TextPrimary}" FontSize="13.5" IsChecked="True" Margin="0,8,0,0" />
                            <CheckBox x:Name="TuningGlobalCacheCheck" Content="Force global rendering cache" Foreground="{StaticResource TextPrimary}" FontSize="13.5" IsChecked="True" Margin="0,8,0,0" />
                            <CheckBox x:Name="TuningDiscreteGpuCheck" Content="Prioritize discrete graphics card" Foreground="{StaticResource TextPrimary}" FontSize="13.5" IsChecked="True" Margin="0,8,0,0" />
                            <CheckBox x:Name="TuningRenderOptimizeCheck" Content="Enable rendering optimization" Foreground="{StaticResource TextPrimary}" FontSize="13.5" IsChecked="True" Margin="0,8,0,0" />
                            <CheckBox x:Name="TuningVSyncCheck" Content="Enable vertical sync (V-Sync)" Foreground="{StaticResource TextPrimary}" FontSize="13.5" IsChecked="False" Margin="0,8,0,0" />
                            <CheckBox x:Name="TuningAntiAliasingCheck" Content="Anti-aliasing" Foreground="{StaticResource TextPrimary}" FontSize="13.5" IsChecked="True" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="1" Background="{StaticResource CardSurface}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Width="3" Height="14" Background="{StaticResource Accent}" CornerRadius="1.5" Margin="0,0,7,0" VerticalAlignment="Center" />
                            <TextBlock Text="APPLY" Foreground="{StaticResource TextPrimary}" FontFamily="Bahnschrift SemiCondensed" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                        <Border Background="#091219" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
                            <TextBlock x:Name="TuningStatusText" Text="Open this page to load the emulator's current settings." Foreground="{StaticResource AccentHover}" FontSize="13" TextWrapping="Wrap" />
                        </Border>
                        <TextBlock Text="To apply settings, click the button." Foreground="{StaticResource TextSecondary}" FontSize="12.5" Margin="0,0,0,10" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="TuningEndTaskButton" Content="END TASK" Click="TuningEndTaskButton_Click" Style="{StaticResource ToolButtonStyle}" Margin="0,0,10,0" />
                            <Button x:Name="TuningApplyButton" Content="APPLY SETTINGS" Click="TuningApplyButton_Click" Style="{StaticResource PrimaryButtonStyle}" IsEnabled="False" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
